.env
__pycache__/
*.pyc
*.pyo

# wrangler local state (adopted from the auto-config PR before closing it)
.wrangler/
.dev.vars*
!.dev.vars.example

# local agent/session state — never commit (contains launch.json)
.claude/

# v3 report runtime state (per-ticker "what changed" diff keys) and
# generated report artefacts — both are outputs, not sources.
.report_state/
.report_state_test/
out_v3/
.snapcache/

# v3 build scratch written to the repo root by the CI report job.
# publish_reports.sh stages only explicit paths so these are never
# committed, but an accidental `git add -A` should not ship a 200KB PDF.
*_research_brief_v3.pdf
*_research_brief_v3_appendix.pdf
*_research_brief_v3_evidence.json
*_research_brief_v3_validation.json

# rendered social cards (CI artifacts, never published)
docs/cards/

# ── Data lives in Cloudflare R2 since the 2026-09-28 cutover ─────────
# Workflows `r2_sync.py pull` at start and publish_reports.sh uploads what
# they changed. Local dev: `python scripts/r2_sync.py pull-public` fetches
# the public reports (no token). Kept in git: hand-edited config, test
# fixtures, and manifest.json (derived from the report PDFs, which stay).
/data/*
!/data/fixtures_expected.json
!/data/hedge_monitor_exclusions.jsonl
!/data/mutation_proofs/
!/data/research_state/
!/data/listing_facts/
/docs/reports/*.json
!/docs/reports/manifest.json
!/docs/reports/event_overrides.json
.r2_manifest.json
