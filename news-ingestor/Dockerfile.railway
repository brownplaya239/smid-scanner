# Build context = REPO ROOT (used by the root railway.json so Railway builds
# the ingestor with NO "Root Directory" setting needed). COPY paths are
# repo-root-relative. For a standalone `docker build news-ingestor/`, use the
# sibling ./Dockerfile instead (context = news-ingestor/).
FROM node:22-alpine
WORKDIR /app
COPY news-ingestor/package.json ./
RUN npm install --omit=dev
COPY news-ingestor/index.mjs ./
CMD ["node", "index.mjs"]
